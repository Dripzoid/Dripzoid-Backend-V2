generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/**
 * ======================================================
 * ENUMS
 * ======================================================
 */

enum CouponType {
  percentage
  fixed
}

enum CouponAppliesTo {
  all
  shipping
  category
  product
}

enum MessageRole {
  user
  assistant
  system
}

enum CouponTargetType {
  category
  product
}

enum JobType {
  Internship
  Full_time
  Part_time
}

enum CategoryType {
  Men
  Women
  Kids
  men
  women
  kids
}

enum CategoryStatus {
  active
  inactive
}

enum VoteType {
  like
  dislike
}

enum EntityType {
  review
  answer
}

/**
 * ======================================================
 * USERS
 * ======================================================
 */

model User {
  id String @id @default(uuid())

  name     String?
  email    String  @unique
  phone    String?
  password String

  gender String?
  dob    DateTime?

  isAdmin Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  addresses     Address[]
  cartItems     CartItem[]
  wishlistItems WishlistItem[]
  orders        Order[]
  sessions      UserSession[]
  activities    UserActivity[]

  notifications UserNotification?
  security      UserSecurity?

  reviews   Review[]
  questions Question[]
  answers   Answer[]

  applications Application[]

  auditLogs AuditLog[]

  conversations      Conversation[]
  aiUsages           AiUsage[]
  preferences        UserPreference?
  savedConversations SavedConversation[]

  @@index([email])
  @@index([phone])
}

/**
 * ======================================================
 * ADDRESSES
 * ======================================================
 */

model Address {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  label String?
  name  String?
  phone String?

  line1 String?
  line2 String?

  city  String?
  state String?

  pincode String?
  country String  @default("India")

  isDefault Boolean @default(false)

  createdAt DateTime @default(now())

  orders Order[]

  @@index([userId])
}

/**
 * ======================================================
 * PRODUCTS
 * ======================================================
 */

model Product {
  id String @id @default(uuid())

  name String
  slug String @unique

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  subcategory String?

  description String?

  price         Float
  originalPrice Float?
  actualPrice   Float?

  rating Float?

  stock Int @default(0)
  sold  Int @default(0)

  featured Boolean @default(false)

  images Json?
  colors Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sizes ProductSize[]

  cartItems     CartItem[]
  wishlistItems WishlistItem[]

  reviews   Review[]
  questions Question[]

  orderItems OrderItem[]

  saleProducts   SaleProduct[]
  productVectors ProductVector[]

  @@index([name])
  @@index([slug])
  @@index([createdAt])
}

/**
 * ======================================================
 * PRODUCT SIZES
 * ======================================================
 */

model ProductSize {
  id String @id @default(uuid())

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  size  String
  stock Int    @default(0)

  @@index([productId])
}

/**
 * ======================================================
 * CATEGORIES
 * ======================================================
 */

model Category {
  id String @id @default(uuid())

  category    CategoryType
  subcategory String

  slug String @unique

  status CategoryStatus @default(active)

  sortOrder Int @default(0)

  parentId String?
  parent   Category? @relation("CategoryHierarchy", fields: [parentId], references: [id])

  children Category[] @relation("CategoryHierarchy")

  metadata Json?

  isDeleted Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]

  @@unique([category, subcategory])
}

/**
 * ======================================================
 * CART
 * ======================================================
 */

model CartItem {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  size  String?
  color String?

  quantity Int @default(1)

  addedAt DateTime @default(now())

  @@index([userId])
  @@index([productId])
}

/**
 * ======================================================
 * WISHLIST
 * ======================================================
 */

model WishlistItem {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

model Order {
  id String @id @default(uuid())

  orderNumber String @unique

  userId String
  user   User   @relation(fields: [userId], references: [id])

  addressId String?
  address   Address? @relation(fields: [addressId], references: [id])

  totalAmount Float

  paymentMethod String?

  status String @default("Pending")

  paymentDetails Json?

  shippingAddress Json?

  deliveryDate DateTime?

  razorpayOrderId   String?
  razorpayPaymentId String?
  razorpayAmount    Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items OrderItem[]

  shipment Shipment?

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

/**
 * ======================================================
 * ORDER ITEMS
 * ======================================================
 */

model OrderItem {
  id String @id @default(uuid())

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id])

  quantity Int @default(1)

  unitPrice Float
  price     Float?

  selectedColor String?
  selectedSize  String?

  @@index([orderId])
  @@index([productId])
}

/**
 * ======================================================
 * REVIEWS
 * ======================================================
 */

model Review {
  id String @id @default(uuid())

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  votes Vote[]

  rating Int

  text     String?
  imageUrl String?

  createdAt DateTime @default(now())

  @@index([productId])
  @@index([userId])
}

/**
 * ======================================================
 * QUESTIONS
 * ======================================================
 */

model Question {
  id String @id @default(uuid())

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  text String

  createdAt DateTime @default(now())

  answers Answer[]
}

/**
 * ======================================================
 * ANSWERS
 * ======================================================
 */

model Answer {
  id String @id @default(uuid())

  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  text String

  createdAt DateTime @default(now())
}

/**
 * ======================================================
 * VOTES
 * ======================================================
 */

model Vote {
  id String @id @default(uuid())

  entityId String

  entityType EntityType

  userId String

  reviewId String

  vote VoteType

  createdAt DateTime @default(now())

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@unique([entityId, entityType, userId])
}

/**
 * ======================================================
 * SALES
 * ======================================================
 */

model Sale {
  id String @id @default(uuid())

  name String

  enabled   Boolean @default(true)
  isDeleted Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products SaleProduct[]
}

model SaleProduct {
  id String @id @default(uuid())

  saleId String
  sale   Sale   @relation(fields: [saleId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  position Int @default(0)

  createdAt DateTime @default(now())

  @@unique([saleId, productId])
}

/**
 * ======================================================
 * COUPONS
 * ======================================================
 */

model Coupon {
  id String @id @default(uuid())

  code String @unique

  type CouponType

  amount Float

  minPurchase Float @default(0)

  usageLimit Int @default(0)
  used       Int @default(0)

  startsAt DateTime?
  endsAt   DateTime?

  active Boolean @default(true)

  appliesTo CouponAppliesTo @default(all)

  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  targets   CouponTarget[]
  usages    CouponUsage[]
  auditLogs CouponAuditLog[]
}

model CouponTarget {
  id String @id @default(uuid())

  couponId String
  coupon   Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)

  targetType CouponTargetType

  targetId String

  @@index([couponId])
}

model CouponUsage {
  id String @id @default(uuid())

  couponId String
  coupon   Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)

  orderId String?
  userId  String?

  discountAmount Float

  usedAt DateTime @default(now())
}

model CouponAuditLog {
  id String @id @default(uuid())

  couponId String?
  coupon   Coupon? @relation(fields: [couponId], references: [id], onDelete: SetNull)

  action  String
  message String

  actor String @default("system")

  createdAt DateTime @default(now())
}

/**
 * ======================================================
 * JOBS / APPLICATIONS
 * ======================================================
 */

model Job {
  id String @id @default(uuid())

  slug String @unique

  title String

  type JobType

  location   String?
  department String?

  duration String?
  stipend  String?

  status String @default("Open")

  description String?

  createdAt DateTime @default(now())

  applications Application[]
}

model Application {
  id String @id @default(uuid())

  jobId String
  job   Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  name  String
  email String

  phone String?

  portfolio String?
  cover     String?

  resumeUrl String?

  status String @default("Applied")

  certificateGenerated Boolean @default(false)

  appliedAt DateTime @default(now())

  certificates Certificate[]
}

model Certificate {
  id String @id @default(uuid())

  applicationId String?
  application   Application? @relation(fields: [applicationId], references: [id])

  certificateId String @unique

  internName String
  role       String

  startDate DateTime?
  endDate   DateTime?

  issueDate DateTime?

  certificateUrl String?
  qrUrl          String?

  createdAt DateTime @default(now())
}

/**
 * ======================================================
 * SLIDES
 * ======================================================
 */

model Slide {
  id String @id @default(uuid())

  name String

  imageUrl String

  link String?

  orderIndex Int @default(0)

  isDeleted Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/**
 * ======================================================
 * USER SETTINGS
 * ======================================================
 */

model UserNotification {
  userId String @id

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  email Boolean @default(true)
  sms   Boolean @default(false)
  push  Boolean @default(true)

  marketing Boolean @default(false)

  orderUpdates Boolean @default(true)
}

model UserSecurity {
  userId String @id

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  twoFaEnabled Boolean @default(false)

  backupCodes Json?
}

/**
 * ======================================================
 * SESSIONS
 * ======================================================
 */

model UserSession {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  device String?
  ip     String?

  lastActive DateTime?

  createdAt DateTime @default(now())
}

/**
 * ======================================================
 * USER ACTIVITY
 * ======================================================
 */

model UserActivity {
  id String @id @default(uuid())

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  action String

  createdAt DateTime @default(now())
}

/**
 * ======================================================
 * OTP
 * ======================================================
 */

model OtpData {
  email String @id

  otpHash String

  otpCreatedAt BigInt

  attempts Int @default(0)
}

/**
 * ======================================================
 * AUDIT LOGS
 * ======================================================
 */

model AuditLog {
  id String @id @default(uuid())

  adminId String?
  admin   User?   @relation(fields: [adminId], references: [id])

  actionType String

  entityType String

  entityId String?

  details Json?

  createdAt DateTime @default(now())
}

/**
 * ======================================================
 * ASKDRIP CONVERSATIONS
 * ======================================================
 */

model Conversation {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages           Message[]
  savedConversations SavedConversation[]
  aiUsages           AiUsage[]

  @@index([userId])
  @@index([createdAt])
}

/**
 * ======================================================
 * ASKDRIP MESSAGES
 * ======================================================
 */

model Message {
  id String @id @default(uuid())

  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  role    MessageRole
  content String      @db.Text

  model String?

  tokenCount Int?

  createdAt DateTime @default(now())

  @@index([conversationId])
  @@index([createdAt])
}

/**
 * ======================================================
 * ASKDRIP SAVED CHATS
 * ======================================================
 */

model SavedConversation {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, conversationId])
}

/**
 * ======================================================
 * ASKDRIP USAGE
 * ======================================================
 */

model AiUsage {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id])

  model String

  promptTokens     Int @default(0)
  completionTokens Int @default(0)
  totalTokens      Int @default(0)

  estimatedCost Float @default(0)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

/**
 * ======================================================
 * ASKDRIP USER PREFERENCES
 * ======================================================
 */

model UserPreference {
  userId String @id

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  preferredModel String?

  systemPrompt String? @db.Text

  temperature Float? @default(0.7)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/**
 * =====================================================
 * PRODUCT VECTORS
 * =====================================================
 */

model ProductVector {
  productId String @id @map("product_id")

  embedding Unsupported("vector(384)")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_vectors")
}

/**
 * =====================================================
 * KB VECTORS
 * =====================================================
 */

model KBVector {
  id String @id @default(uuid()) @db.Uuid

  route String

  factText String @map("fact_text") @db.Text

  embedding Unsupported("vector(384)")

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([route, factText])
  @@map("kb_vectors")
}

/**
 * =====================================================
 * AUTOMATION EVENTS
 * =====================================================
 */

model AutomationEvent {
  id        String @id @default(uuid())
  eventType String
  payload   Json

  source String @default("dripzoid-backend")

  status String @default("pending")

  retryCount Int     @default(0)
  lastError  String?

  processedAt DateTime?

  createdAt DateTime @default(now())

  @@index([status])
  @@index([eventType])
  @@index([createdAt])
  @@map("automation_events")
}

/**
 * =====================================================
 * EMAIL LOGS
 * =====================================================
 */

model EmailLog {
  id String @id @default(uuid())

  recipientEmail String
  subject        String

  templateName String?
  eventType    String?

  provider          String  @default("msg91")
  providerMessageId String?

  status String

  errorMessage String?

  sentAt DateTime?

  createdAt DateTime @default(now())

  @@index([status])
  @@index([recipientEmail])
  @@index([eventType])
  @@index([createdAt])
  @@map("email_logs")
}

/**
 * =====================================================
 * SCHEDULED TASKS
 * =====================================================
 */

model ScheduledTask {
  id String @id @default(uuid())

  taskType String
  payload  Json

  executeAt DateTime

  status String @default("pending")

  executedAt DateTime?

  retryCount Int @default(0)

  lastError String?

  createdAt DateTime @default(now())

  @@index([status])
  @@index([executeAt])
  @@index([taskType])
  @@map("scheduled_tasks")
}

/**
 * =====================================================
 * AUTOMATION LOGS
 * =====================================================
 */

model AutomationLog {
  id String @id @default(uuid())

  level String

  service String?

  message String

  metadata Json?

  createdAt DateTime @default(now())

  @@index([level])
  @@index([service])
  @@index([createdAt])
  @@map("automation_logs")
}

/**
 * =====================================================
 * AUTOMATION CONFIGS
 * =====================================================
 */

model AutomationConfig {
  id String @id @default(uuid())

  configKey   String @unique
  configValue String

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@map("automation_configs")
}

/**
 * =====================================================
 * AUTOMATION TEMPLATES
 * =====================================================
 */

model AutomationTemplate {
  id String @id @default(uuid())

  name String @unique

  type String

  subject String?

  content String @db.Text

  isActive Boolean @default(true)

  version Int @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
  @@index([isActive])
  @@map("automation_templates")
}

model Shipment {
  id String @id @default(uuid())

  orderId String @unique
  order   Order  @relation(fields: [orderId], references: [id])

  shiprocketOrderId String?
  shipmentId        String? @unique

  awbCode String?

  courierId   Int?
  courierName String?

  shipmentStatus String?

  pickupScheduledAt DateTime?
  pickupTokenNumber String?

  assignedAt DateTime?

  isReturn Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  trackingEvents ShipmentTracking[]
}

model ShipmentTracking {
  id String @id @default(uuid())

  shipmentId String
  shipment   Shipment @relation(fields: [shipmentId], references: [id])

  status   String
  activity String

  location String?

  scanTimestamp DateTime?

  createdAt DateTime @default(now())
}

model Courier {
  id Int @id

  name String

  baseCourierId Int?

  minWeight Float?

  mode Int?

  serviceType Int?

  isActive Boolean @default(true)

  realtimeTracking String?

  podAvailable String?

  callBeforeDelivery String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ServiceabilityCheck {
  id String @id @default(uuid())

  orderId String?

  courierId Int?

  courierName String?

  estimatedDays Int?

  etd String?

  freightCharge Float?

  rtoCharges Float?

  rating Float?

  isRecommended Boolean @default(false)

  createdAt DateTime @default(now())
}

model ShipmentWebhookEvent {
  id String @id @default(uuid())

  shipmentId        String?
  shiprocketOrderId String?

  status String?

  payload Json

  createdAt DateTime @default(now())
}
